# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# PostgreSQL session store (Render provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Session secret
SESSION_SECRET=your-secret-key

# Admin password for dashboard access
ADMIN_PASSWORD=admin123

# Email (optional, for reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Research Portal <noreply@example.com>"

# Frontend URL for reminder links (use your deployed URL)
FRONTEND_URL=https://your-app.onrender.com
